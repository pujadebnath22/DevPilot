# DevPilot backend — local configuration template.
# Copy to backend/.env (git-ignored) and fill in real values. Never commit the real file.

# PostgreSQL + pgvector (docker-compose.yml exposes it on host port 5433)
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional overrides
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# GitHub OAuth App — https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend origin (used for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Encrypts stored GitHub access tokens.
# Password: any long random string. Salt: HEX-encoded, e.g. output of `openssl rand -hex 16`.
# Changing these later makes previously stored tokens undecryptable (users must sign in again).
TOKEN_ENCRYPTOR_PASSWORD=change_me_to_a_long_random_string
TOKEN_ENCRYPTOR_SALT=change_me_hex_salt

# Set to true when the backend is served over HTTPS
SESSION_COOKIE_SECURE=false
